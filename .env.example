# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库。

# ── 模型路由（P1）────────────────────────────────────────
# 前缀决定 provider：
#   claude-*      → Anthropic
#   gemini-*      → Google
#   grok-*        → xAI
#   deepseek-*    → DeepSeek
#   openrouter/*  → OpenRouter
#   ollama/*      → 本地 Ollama
#   其它          → OpenAI（或 OpenAI 兼容网关）
DEXTER_MODEL=gpt-6-astra

# 采样温度 0–2，越低越稳定
DEXTER_TEMPERATURE=0.2

# 单次提问最多几轮工具调用，范围 1–25
DEXTER_MAX_ITERATIONS=10

# 1 = 每轮打印迭代信息（等价于 --verbose）
DEXTER_VERBOSE=0

# 1 = 打印与 LLM 的完整通信（等价于 --trace）
DEXTER_TRACE=0

# ── API Key（只需填模型对应的那一个）────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ── OpenAI 兼容网关 ────────────────────────────────────
# 走代理/自建网关时填这里；优先级：provider 固定地址 > OPENAI_BASE_URL > DEXTER_BASE_URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# 本地 Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── 后续阶段才需要（P4 起）──────────────────────────────
# FINANCIAL_DATASETS_API_KEY=
# EXASEARCH_API_KEY=
# TAVILY_API_KEY=
